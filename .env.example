# URL publica do site, sem barra no final. Dominio registrado no registro.br.
# ATENCAO: e NEXT_PUBLIC_*, ou seja, e embutida no BUILD — alterar na Vercel
# depois do deploy nao muda nada sem um rebuild.
NEXT_PUBLIC_SITE_URL="https://vitasaudecorporativa.com.br"

# --- E-mail: Brevo (a rota /api/lead le ESTAS variaveis) -------------------
# Crie a chave em https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""

# Remetente. Precisa de dominio verificado na Brevo para producao.
BREVO_SENDER_EMAIL="contato@vitasaudecorporativa.com.br"
BREVO_SENDER_NAME="Vita Saude"

# Copia de cada lead novo cai neste e-mail. Um dos dois canais de alerta
# (o outro e o EVOLUTION_GROUP_JID); configure pelo menos um.
LEAD_NOTIFICATION_TO=""

# "false" desliga o anexo de 3,4 MB e envia so o link de download.
# Recomendado em producao: o e-mail ja leva o link.
EMAIL_ATTACH_PDF="false"

# --- Banco: Supabase (onde o lead e persistido) ---------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- WhatsApp: Evolution API (envio automatico do material) ---------------
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_API_INSTANCE=""

# ID do grupo de WhatsApp que recebe um aviso a cada lead cadastrado.
# NAO e um numero de telefone: e o JID do grupo, no formato 1203...@g.us.
# Para descobrir, com a instancia conectada e o numero dela DENTRO do grupo:
#   curl -H "apikey: SUA_CHAVE" "https://SEU_HOST/group/fetchAllGroups/SUA_INSTANCIA?getParticipants=false"
# A resposta lista id + subject de cada grupo; use o id do grupo certo.
# Na Vercel: marque so o ambiente Production e NAO marque "Sensitive" — o valor
# precisa continuar legivel para conferencia (uma instancia costuma enxergar
# grupos de varios projetos, e o ID errado entrega o aviso no grupo errado).
# Vazio = nenhum aviso no grupo (o alerta por e-mail continua).
EVOLUTION_GROUP_JID=""

# --- Analytics (opcional) -------------------------------------------------
# Sem isto, os eventos de conversao (whatsapp_click, lead_submit,
# ebook_download, lead_error) sao empurrados para um dataLayer que ninguem le.
NEXT_PUBLIC_GTM_ID=""
